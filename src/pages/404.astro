---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="페이지를 찾을 수 없습니다 · 유재홍"><section class="shell not-found"><span class="error-number">404</span><h1>이 페이지는 찾을 수 없어요.</h1><p>주소가 바뀌었거나 존재하지 않는 페이지입니다.</p><a class="button button-dark" href={base}>프로젝트로 돌아가기 <Arrow /></a></section></Base>
