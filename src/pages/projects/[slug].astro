---
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import projects from '../../data/projects.json';
export function getStaticPaths() { return projects.map((project, index) => ({ params: { slug: project.slug }, props: { project, next: projects[(index + 1) % projects.length] } })); }
const { project, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${project.title} · 유재홍`} description={project.summary}>
  <article class="case-study shell">
    <a class="back-link" href={`${base}/#projects`}><Arrow direction="left" /> 전체 프로젝트</a>
    <header class="case-heading"><h1>{project.title}</h1><p class="case-summary">{project.summary}</p><div class="case-meta"><span>{project.categoryLabel}</span><span>{project.tools.join(' / ')}</span></div><div class="case-overview"><p>{project.outcome}</p><div class="case-quick-links"><a class="text-link" href="#evaluation">검증 내용 <Arrow /></a>{project.links.map(link => <a class="text-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<Arrow direction="up" /></a>)}</div></div></header>
    <div class="case-layout">
      <aside class="case-toc" aria-label="이 프로젝트의 목차"><a href="#problem">문제</a><a href="#approach">설계</a><a href="#evaluation">결과와 검증</a>{(project.images.length > 0 || project.videos.length > 0) && <a href="#evidence">결과 자료</a>}{project.links.length > 0 && <a href="#links">원문과 코드</a>}</aside>
      <div class="case-body">
        <section id="problem"><h2>해결할 문제</h2><p>{project.problem}</p></section>
        <section id="approach"><h2>설계와 구현</h2><ul class="approach-list">{project.approach.map(item => <li>{item}</li>)}</ul></section>
        <section id="evaluation"><h2>결과와 검증</h2><p class="result-statement">{project.outcome}</p><p>{project.evaluation}</p>{project.detail && <p>{project.detail}</p>}</section>
        {(project.images.length > 0 || project.videos.length > 0) && <section id="evidence"><h2>결과 자료</h2>
          {project.videos.length > 0 && <><p>계절별 관측과 예측을 비교할 수 있습니다. 영상을 재생하면 해당 파일을 불러옵니다.</p><div class="video-list">{project.videos.map(video => <figure><h3>{video.label}</h3><video controls playsinline preload="none" width={video.width} height={video.height} poster={`${base}${video.poster}`} aria-label={video.alt}><source src={`${base}${video.src}`} type="video/mp4" /><a href={`${base}${video.src}`}>영상 다운로드</a></video></figure>)}</div></>}
          <div class:list={['evidence-images', project.slug === 'smp' && 'evidence-charts']}>{project.images.map(img => <figure><div class="figure-heading"><h3>{img.label}</h3><a href={`${base}${img.src}`} target="_blank" rel="noopener noreferrer" aria-label={`${img.label} 크게 보기 (새 탭)`}>크게 보기 <Arrow direction="up" /></a></div><a class="image-link" href={`${base}${img.src}`} target="_blank" rel="noopener noreferrer" aria-label={`${img.label} 원본 크기로 보기`}><img src={`${base}${img.src}`} alt={img.alt} width={img.width} height={img.height} loading="lazy" decoding="async" /></a></figure>)}</div>
        </section>}
        {project.links.length > 0 && <section id="links"><h2>원문과 코드</h2><div class="source-links">{project.links.map(link => <a class="text-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<Arrow direction="up" /></a>)}</div></section>}
      </div>
    </div>
    <a class="next-project" href={`${base}/projects/${next.slug}/`}><span>다음 프로젝트<strong>{next.title}</strong></span><Arrow /></a>
  </article>
</Base>
