---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import projects from '../data/projects.json';
import profile from '../data/profile.json';
import SmpComparison from '../components/SmpComparison.astro';
import ResearchShowcase from '../components/ResearchShowcase.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projectUrl = (slug: string) => `${base}/projects/${slug}/`;
const selected = ['smp', 'mojo'].map(slug => projects.find(project => project.slug === slug)!);
const categoryCount = (category: string) => projects.filter(project => project.category === category).length;
---
<Base poster>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-intro">
      <h1 id="hero-title">시계열 예측,<br /><span>쓸 수 있는 AI.</span></h1>
      <div class="hero-signature"><span class="signature-name">{profile.nameKo}</span><span>{profile.role}</span></div>
    </div>
    <div class="hero-context">
      <p class="intro-copy">생물정보학 연구에서 익힌 검정과 평가를 바탕으로, 전력 예측과 LLM 시스템을 만듭니다. 모델의 선택부터 검증, 실제 사용까지 연결합니다.</p>
      <div class="hero-actions"><a class="button button-dark" href="#work">대표 작업 보기 <Arrow /></a><a class="text-link" href="#projects">전체 {projects.length}개 보기 <Arrow /></a></div>
    </div>
    <div class="hero-work">
      <div class="hero-work-top"><h2>위성 관측으로 보는 3시간 뒤의 수증기</h2><a class="work-open" href={projectUrl('nowcasting')}>프로젝트 보기 <Arrow direction="up" /></a></div>
      <video class="hero-video" controls playsinline preload="none" width="1584" height="462" poster={`${base}/media/06-spring-nowcasting-gif.webp`} aria-label="봄 관측 사례의 위성 영상과 모델 예측 비교. 재생 버튼을 누르면 8.8초 영상을 불러옵니다."><source src={`${base}/media/06-spring-nowcasting-gif.mp4`} type="video/mp4" /><a href={`${base}/media/06-spring-nowcasting-gif.mp4`}>예측 비교 영상 다운로드</a></video>
      <div class="hero-work-bottom"><span>10분 간격의 관측 12장 → 미래 영상 18장</span><span>봄 테스트 · 직접 재생</span></div>
    </div>
  </section>

  <section class="selected-section shell" id="work" aria-labelledby="work-title">
    <div class="section-heading"><h2 id="work-title">대표 프로젝트<span class="accent-period">.</span></h2><a class="text-link" href="#projects">전체 프로젝트 보기 <Arrow /></a></div>
    {selected.map(project => (
      <article class:list={['featured-project', `feature-${project.slug}`]}>
        {project.slug === 'smp' ? <SmpComparison images={project.images.slice(0,3)} /> : <a class="project-visual" href={projectUrl(project.slug)} aria-label={`${project.shortTitle} 화면과 구현 자세히 보기`}><span class="visual-label">{project.slug === 'mojo' ? '초기 지식 검토 화면' : '카카오톡 응답 화면'} <Arrow direction="up" /></span><img src={`${base}${project.images[0].src}`} alt={project.images[0].alt} width={project.images[0].width} height={project.images[0].height} loading="lazy" decoding="async" /></a>}
        <div class="featured-copy">
          <h3><a href={projectUrl(project.slug)}>{project.shortTitle}</a></h3>
          <div class="project-meta"><span>{project.categoryLabel}</span><span>{project.slug === 'smp' ? '전력시장' : '개인 프로젝트'}</span></div>
          <p>{project.summary}</p>
          <p class="project-outcome">{project.outcome}</p>
          <div class="project-tools">{project.tools.slice(0, 3).map(tool => <span>{tool}</span>)}</div>
          <a class="text-link project-read" href={projectUrl(project.slug)}>설계와 결과 보기 <Arrow /></a>
        </div>
      </article>
    ))}
  </section>

  <ResearchShowcase />

  <section class="project-index shell" id="projects" aria-labelledby="index-title">
    <div class="section-heading"><h2 id="index-title">전체 프로젝트</h2><span class="index-count">{projects.length}개 프로젝트</span></div>
    <div class="project-filters" aria-label="프로젝트 분야 필터" hidden>
      <button type="button" data-filter="all" aria-pressed="true">전체 <span>{projects.length}</span></button>
      <button type="button" data-filter="forecasting" aria-pressed="false">시계열 예측 <span>{categoryCount('forecasting')}</span></button>
      <button type="button" data-filter="systems" aria-pressed="false">LLM 시스템 <span>{categoryCount('systems')}</span></button>
      <button type="button" data-filter="research" aria-pressed="false">바이오 · 연구 <span>{categoryCount('research')}</span></button>
    </div>
    <p class="sr-only" id="filter-status" role="status" aria-live="polite"></p>
    <div class="project-list">{projects.map(project => <a class="project-row" data-category={project.category} href={projectUrl(project.slug)}><div><h3>{project.shortTitle}</h3><p>{project.cardSummary}</p></div><span class="row-category">{project.categoryLabel}</span><Arrow direction="up" /></a>)}</div>
  </section>

  <section class="about-section" id="about" aria-labelledby="about-title">
    <div class="shell about-grid">
      <div class="about-intro"><h2 id="about-title">분야는 달라도,<br />일하는 기준은 같습니다.</h2><p>통계적 검정에서 시작해 시계열 예측과 생성형 AI 시스템으로 작업의 범위를 넓혀 왔습니다. 모델을 선택하는 일만큼, 무엇을 평가하고 어떻게 사용할지 설계하는 일을 중요하게 생각합니다.</p><a class="text-link" href="https://github.com/codespermuted" target="_blank" rel="noopener noreferrer">코드와 작업 기록 <Arrow direction="up" /></a></div>
      <div class="about-details"><div class="bio-group"><h3>경력</h3><dl>{profile.career.map(item => <div><dt>{item.organization}</dt><dd>{item.role}</dd></div>)}</dl></div><div class="bio-group"><h3>학력</h3><dl>{profile.education.map(item => <div><dt>{item.institution}</dt><dd>{item.focus}</dd></div>)}</dl></div></div>
      <div class="principles">{profile.principles.map(principle => <div><h3>{principle.title}</h3><p>{principle.description}</p></div>)}</div>
    </div>
  </section>
</Base>

<script>
  const filters = document.querySelector<HTMLElement>('.project-filters');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const rows = [...document.querySelectorAll<HTMLElement>('[data-category]')];
  if (filters) filters.hidden = false;
  function applyFilter(category: string, announce = true) {
    const button = buttons.find(item => item.dataset.filter === category) ?? buttons[0];
    category = button.dataset.filter ?? 'all';
    let visible = 0;
    rows.forEach(row => { row.hidden = category !== 'all' && row.dataset.category !== category; if (!row.hidden) visible++; });
    buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    const status = document.getElementById('filter-status');
    if (status && announce) status.textContent = `${visible}개 프로젝트를 표시합니다.`;
    const count = document.querySelector('.index-count');
    if (count) count.textContent = `${visible}개 프로젝트`;
    try { sessionStorage.setItem('portfolio-category', category); } catch {}
  }
  buttons.forEach(button => button.addEventListener('click', () => applyFilter(button.dataset.filter ?? 'all')));
  try { applyFilter(sessionStorage.getItem('portfolio-category') ?? 'all', false); } catch {}
</script>
