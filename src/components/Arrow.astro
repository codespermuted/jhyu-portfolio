---
const { direction = 'right', class: className = '' } = Astro.props;
---
<svg class:list={['arrow', className]} width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" style={direction === 'up' ? 'transform:rotate(-45deg)' : direction === 'left' ? 'transform:rotate(180deg)' : undefined}>
  <path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
</svg>
