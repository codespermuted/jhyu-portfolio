---
import projects from '../data/projects.json';
import Arrow from './Arrow.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const studies = [
  { slug: 'timeseries-agent', focus: '모델 설계 자동화', image: 0 },
  { slug: 'inflammation', focus: '실험 배치를 고려한 검증', image: 0 },
  { slug: 'ddi', focus: '새로운 약물에 대한 일반화', image: 1 },
].map(item => ({ ...item, project: projects.find(project => project.slug === item.slug)! }));
---
<section class="research-section shell" id="research" aria-labelledby="research-title">
  <div class="research-heading">
    <h2 id="research-title">모델링과 검증<span class="accent-period">.</span></h2>
    <p>모델을 만드는 방법과, 결과를 믿을 수 있는 조건을 함께 설계합니다.</p>
  </div>
  <div class="research-grid">
    {studies.map(({ project, focus, image }, index) => {
      const artifact = project.images[image];
      const url = `${base}/projects/${project.slug}/`;
      return <article class:list={['research-study', index === 0 && 'research-lead']}>
        <div class="research-copy">
          <h3><a href={url}>{project.shortTitle}</a></h3>
          <p class="research-focus">{focus}</p>
          <p>{project.summary}</p>
          <p class="research-outcome">{project.outcome}</p>
          <a class="text-link" href={url}>설계와 검증 보기 <Arrow /></a>
        </div>
        <a class="research-artifact" href={url} aria-label={`${project.shortTitle} 자료와 검증 자세히 보기`}>
          <img src={`${base}${artifact.src}`} alt={artifact.alt} width={artifact.width} height={artifact.height} loading="lazy" decoding="async" />
        </a>
      </article>;
    })}
  </div>
</section>
