---
import '../styles/global.css';
import Arrow from '../components/Arrow.astro';
import profile from '../data/profile.json';
const { title = '유재홍 · Data Scientist', description = '바이오 통계에서 전력 시계열 예측, LLM 시스템까지. 유재홍의 연구와 개발 프로젝트를 소개합니다.', poster = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f3ed" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${base}/social-preview.png`, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preload" href={`${base}/fonts/instrument-sans-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/noto-sans-kr-subset.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={`${base}/fonts/fonts.css`} />
    {poster && <link rel="preload" as="image" href={`${base}/media/06-spring-nowcasting-gif.webp`} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 바로가기</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href={home} aria-label={`${profile.nameKo} 포트폴리오 홈`}>{profile.nameEn}<span class="brand-dot" aria-hidden="true"></span></a>
        <span class="header-role" lang="en">{profile.role}</span>
        <nav aria-label="주 메뉴">
          <a href={`${home}#projects`}>프로젝트</a>
          <a href={`${home}#about`}>소개</a>
          <a class="contact-nav" href={`${home}#contact`}>연락하기 <Arrow direction="up" /></a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer" id="contact">
      <div class="shell">
        <div class="footer-main">
          <div><h2>다음 문제를<br />함께 풀어볼까요?</h2><p>시계열 예측, ML 연구, LLM 시스템에 관한 이야기를 기다립니다.</p></div>
          <div class="footer-actions"><a class="email-link" href={`mailto:${profile.email}`}>{profile.email} <Arrow direction="up" /></a><a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <Arrow direction="up" /></a></div>
        </div>
        <div class="footer-bottom"><span>© {new Date().getFullYear()} {profile.nameEn}</span><span>Bioinformatics / Forecasting / LLM Systems</span><a href="#main">맨 위로 <Arrow direction="up" /></a></div>
      </div>
    </footer>
  </body>
</html>
